<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.canvasproject.ui.LoginController"
            stylesheets="@style-auth.css"
            prefWidth="450" prefHeight="400">

    <VBox alignment="CENTER" spacing="16"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

        <!-- Заголовок -->
        <Label text="Canvas App" styleClass="title-label"/>
        <Label text="Войдите в аккаунт" styleClass="subtitle-label"/>

        <!-- Форма -->
        <VBox spacing="10">
            <TextField fx:id="usernameField"
                       promptText="Имя пользователя"
                       styleClass="auth-field"/>
            <PasswordField fx:id="passwordField"
                           promptText="Пароль"
                           styleClass="auth-field"/>
        </VBox>

        <!-- Ошибка -->
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

        <!-- Кнопки -->
        <Button fx:id="loginBtn" text="Войти"
                maxWidth="Infinity" styleClass="primary-btn"/>

        <Separator/>

        <HBox alignment="CENTER" spacing="8">
            <Label text="Нет аккаунта?"/>
            <Button fx:id="registerLink" text="Зарегистрироваться"
                    styleClass="link-btn"/>
        </HBox>
    </VBox>
</AnchorPane>
