# Скопируйте в .env и поправьте под себя.

# Адрес прослушивания: 127.0.0.1 — только этот компьютер, 0.0.0.0 — локальная сеть.
# WS_HOST=127.0.0.1
# WS_PORT=8765

# MongoDB
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=canvas_collab

# Закрытый сервер: новые устройства не регистрируются, вход только по готовому ключу.
# ALLOW_NEW_DEVICES=1

# Устаревший вход по паролю (не нужен).
# ALLOW_PASSWORD_AUTH=0

# Лимиты
# MAX_CONNECTIONS_PER_IP=10
# MAX_MESSAGES_PER_10S=600
# AUTH_TIMEOUT_SECONDS=20

# Встроенный TLS (PKCS12) — включает wss:// без reverse proxy.
# TLS_KEYSTORE=/path/canvas.p12
# TLS_KEYSTORE_PASSWORD=secret

# Адрес сервера для клиента (переопределяет «Сервер…» в интерфейсе).
# WS_URL=ws://localhost:8765
