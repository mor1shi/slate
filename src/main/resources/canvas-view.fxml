<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane fx:id="pane" maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="800.0" prefWidth="1200.0"
            styleClass="pane" stylesheets="style.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.canvasproject.controller">

    <Rectangle fx:id="overlay" width="1200.0" height="800.0" fill="#000000" opacity="0.0" visible="false"/>

    <VBox fx:id="navPanel" prefWidth="280.0" prefHeight="800.0" styleClass="nav-panel" visible="false"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">

        <Label text="Холст" styleClass="nav-canvas-title"/>
        <Label fx:id="navCanvasSize" text="1920×1080 px" styleClass="nav-canvas-size"/>

        <Label text="НАВИГАЦИЯ" styleClass="nav-section-label"/>
        <Button fx:id="homeBtn" text="На главную" styleClass="nav-btn" onAction="#onGoHome"/>
        <Button fx:id="inviteBtn" text="Код приглашения" styleClass="nav-btn-accent" onAction="#onInvite"/>

        <Region prefHeight="4"/>
        <Separator styleClass="nav-separator"/>
        <Region prefHeight="4"/>

        <Label text="ФАЙЛ" styleClass="nav-section-label"/>
        <Button fx:id="resizeBtn" text="Изменить размер" styleClass="nav-btn" onAction="#onResizeCanvas"/>
        <Button fx:id="exportBtn" text="Экспорт PNG" styleClass="nav-btn" onAction="#onExportPng"/>

        <Region prefHeight="4"/>
        <Separator styleClass="nav-separator"/>
        <Region prefHeight="4"/>

        <Label text="ВИД" styleClass="nav-section-label"/>
        <Button fx:id="backgroundBtn" text="Цвет холста" styleClass="nav-btn" onAction="#onToggleBg"/>
        <Button fx:id="zoomInBtn" text="Увеличить" styleClass="nav-btn" onAction="#onZoomIn"/>
        <Button fx:id="zoomOutBtn" text="Уменьшить" styleClass="nav-btn" onAction="#onZoomOut"/>
        <Button fx:id="resetZoomBtn" text="Сбросить масштаб" styleClass="nav-btn" onAction="#onResetZoom"/>

        <Region prefHeight="4"/>
        <Separator styleClass="nav-separator"/>
        <Region prefHeight="4"/>

        <Label text="ПРАВКИ" styleClass="nav-section-label"/>
        <Button fx:id="undoBtn" text="Отменить (Ctrl+Z)" styleClass="nav-btn" onAction="#onUndo"/>
        <Button fx:id="redoBtn" text="Повторить (Ctrl+Y)" styleClass="nav-btn" onAction="#onRedo"/>
        <Button fx:id="clearBtn" text="Очистить всё" styleClass="nav-btn-danger" onAction="#onClearAll"/>

        <Region VBox.vgrow="ALWAYS"/>
        <Label text="Версия 1.0" styleClass="nav-version-label"/>
    </VBox>

    <Button fx:id="menuBtn" layoutX="15.0" layoutY="15.0"
            styleClass="menu-btn" onAction="#toggleNavPanel"/>

    <Label fx:id="connectionLabel" text="● В сети" styleClass="connection-badge"
           AnchorPane.topAnchor="18.0" AnchorPane.rightAnchor="18.0"/>

    <Canvas fx:id="canvas" height="1080.0" width="1920.0"/>
    <VBox alignment="BOTTOM_CENTER"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <HBox alignment="CENTER" maxWidth="365.0" prefHeight="70.0" prefWidth="365.0"
              spacing="15.0" styleClass="hbox" translateY="-20">
            <Button fx:id="penBtn" prefHeight="50.0" prefWidth="50.0" styleClass="penBtn"/>
            <Button fx:id="textBtn" prefHeight="50.0" prefWidth="50.0" styleClass="txtBtn"/>
            <Button fx:id="figureBtn" prefHeight="50.0" prefWidth="50.0" styleClass="figureBtn"/>
            <Button fx:id="imgBtm" prefHeight="50.0" prefWidth="50.0" styleClass="imgBtm"/>
            <Button fx:id="noteBtn" prefHeight="50.0" prefWidth="50.0" styleClass="noteBtn"/>
        </HBox>
    </VBox>
</AnchorPane>
