<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.canvasproject.ui.RegisterController"
            stylesheets="@style-auth.css"
            prefWidth="450" prefHeight="500">

    <VBox alignment="CENTER" spacing="14"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

        <Label text="Canvas App" styleClass="title-label"/>
        <Label text="Создать аккаунт" styleClass="subtitle-label"/>

        <VBox spacing="10">
            <TextField fx:id="usernameField"
                       promptText="Имя пользователя *"
                       styleClass="auth-field"/>
            <TextField fx:id="emailField"
                       promptText="Email (необязательно)"
                       styleClass="auth-field"/>
            <PasswordField fx:id="passwordField"
                           promptText="Пароль (мин. 6 символов) *"
                           styleClass="auth-field"/>
            <PasswordField fx:id="confirmField"
                           promptText="Повторите пароль *"
                           styleClass="auth-field"/>
        </VBox>

        <Label fx:id="errorLabel"   styleClass="error-label"   wrapText="true"/>
        <Label fx:id="successLabel" styleClass="success-label" wrapText="true"/>

        <Button fx:id="registerBtn" text="Зарегистрироваться"
                maxWidth="Infinity" styleClass="primary-btn"/>

        <Separator/>

        <HBox alignment="CENTER" spacing="8">
            <Label text="Уже есть аккаунт?"/>
            <Button fx:id="backToLoginLink" text="Войти" styleClass="link-btn"/>
        </HBox>
    </VBox>
</AnchorPane>
